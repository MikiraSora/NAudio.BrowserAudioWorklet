<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Multi-targeted so the platform-agnostic player state machine builds and
         unit-tests on plain net9.0, while the real System.Runtime.InteropServices.
         JavaScript bridge (guarded by #if BROWSER) only compiles on the browser
         leg. The Razor SDK is used purely for its Static Web Assets pipeline: it
         packs wwwroot/*.js into the nupkg and republishes it under
         _content/NAudio.BrowserAudioWorklet/ in any consuming WASM app,
         so "reference the package" is all it takes to ship the AudioWorklet JS. -->
    <TargetFrameworks>net9.0;net9.0-browser</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <StaticWebAssetBasePath>_content/NAudio.BrowserAudioWorklet</StaticWebAssetBasePath>
    <PackageId>NAudio.BrowserAudioWorklet</PackageId>
    <Version>$(BrowserAudioWorkletPackageVersion)</Version>
    <Title>NAudio browser AudioWorklet output</Title>
    <Authors>NAudio.BrowserAudioWorklet contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>naudio;avalonia;browser;wasm;audio;audio-worklet</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Description>Browser/WebAssembly audio playback for NAudio via the Web Audio AudioWorklet API. Provides BrowserAudioWorkletPlayer, an IWavePlayer that streams any IWaveProvider to the browser's audio output in Avalonia Browser or any .NET WebAssembly app.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exposes the internal IAudioWorkletBridge seam and the internal test
         constructor to the unit tests. This independent repository does not
         strong-name the test assembly, so a simple friend assembly name is enough. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NAudio.BrowserAudioWorklet.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="$(NAudioCorePackageVersion)" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
